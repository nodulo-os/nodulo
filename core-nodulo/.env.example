# Copie para .env e ajuste os valores para sua instalação.
# Os exemplos de credenciais abaixo são apenas para desenvolvimento; não os use em produção.

# Porta HTTP em que o processo Go escuta.
PORT=8081
# Origem exata do frontend autorizada pelo CORS, sem barra final.
FRONTEND_ORIGIN=

# URL de conexão PostgreSQL. Use o hostname interno do banco quando a API estiver em container.
DATABASE_URL=
# Segredo de assinatura JWT, com pelo menos 32 bytes. Gere um valor próprio com:
# openssl rand -base64 48
JWT_SECRET=
# CIDRs dos proxies reversos confiáveis, separados por vírgula. Só eles podem fornecer X-Forwarded-For confiável.
# Exemplo ilustrativo: 10.0.0.0/8. Deixe vazio se a API recebe conexões diretamente.
TRUSTED_PROXY_CIDRS=

# Armazenamento durável dos arquivos da fila de ingestão.
# Use um diretório persistente; no Compose, o serviço define /data/nodulo/ingestion.
INGESTION_STORAGE_DIR=./data/ingestion

# Notificações de decisões: porta 587 usa STARTTLS; porta 465 usa TLS implícito.
# Sem estas variáveis, decisões são salvas, mas o administrador verá que o e-mail não foi enviado.
# Nome DNS do servidor SMTP usado para enviar notificações de cadastro.
SMTP_HOST=
# Porta SMTP: 587/2587 normalmente usa STARTTLS; 465/2465 usa TLS implícito.
SMTP_PORT=587
# Utilizador da conta SMTP, se o provedor exigir autenticação.
SMTP_USERNAME=
# Senha ou token da conta SMTP; mantenha fora do controle de versão.
SMTP_PASSWORD=
# Endereço de remetente autorizado pelo provedor SMTP.
SMTP_FROM=
# URL pública da aplicação incluída nos emails de decisão de cadastro.
APP_PUBLIC_URL=

# Necessário apenas ao executar go run ./cmd/seed-admin
# Email da conta administrativa inicial.
ADMIN_EMAIL=admin@nodulo.local
# Nome exibido para a conta administrativa inicial.
ADMIN_NAME=Administrador NÓDULO
# Senha da conta administrativa inicial; defina antes de executar o seed.
ADMIN_PASSWORD=

# URL base do serviço de inferência, acessível pela API e sem sufixo de endpoint.
# O cliente atual usa protocolo compatível com Ollama; outros protocolos exigem um adaptador.
INFERENCE_BASE_URL=""
# Identificador do modelo de geração disponível no serviço de inferência.
GENERATION_MODEL=""
# Identificador do modelo de embeddings; deve produzir vetores de 768 dimensões.
EMBEDDING_MODEL=""
# Modelo multimodal para mensagens com imagens PNG, JPEG ou WebP.
# Exemplo: llava. Baixe-o no serviço de inferência configurado antes de usar.
# VISION_MODEL é recomendado; LLM_VISION_MODEL é aceito como alias.
VISION_MODEL=""
# URL privada do broker separado de execução Python. Sem este endereço, a ferramenta
# execute_python fica desativada; a API nunca tenta abrir um socket Docker local.
PYTHON_EXECUTOR_URL=""
# Segredo aleatório (mínimo 32 caracteres), igual ao configurado no broker.
PYTHON_EXECUTOR_TOKEN=""

# Pesquisa web: habilitação, provedor e URL SearXNG são configurados na aba
# "Pesquisa web" do painel admin e persistidos no PostgreSQL desta instalação.
# Use a URL privada que a API alcança; não a URL acessada pelo navegador.


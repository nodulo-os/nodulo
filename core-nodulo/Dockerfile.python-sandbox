FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

RUN python -m pip install --no-cache-dir --disable-pip-version-check \
    numpy==2.5.4 \
    matplotlib==3.11.2

WORKDIR /tmp
USER 65534:65534

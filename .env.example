# Configuração de desenvolvimento do Docker Compose.
# Copie para .env e preencha INFERENCE_BASE_URL, GENERATION_MODEL e EMBEDDING_MODEL.
# Nunca use os valores de desenvolvimento abaixo numa instalação pública.

# PostgreSQL criado pelo Compose.
POSTGRES_USER=nodulo
# Gere com `openssl rand -hex 32`. Obrigatória para iniciar o Compose.
POSTGRES_PASSWORD=
POSTGRES_DB=nodulo
POSTGRES_PORT=5432

# Serviço de inferência acessível a partir do container da API.
# Use o hostname interno da rede Docker ou uma URL HTTPS acessível pelo container.
# O backend atual exige uma API compatível com Ollama; o modelo de embeddings deve gerar 768 dimensões.
INFERENCE_BASE_URL=
GENERATION_MODEL=
EMBEDDING_MODEL=
# Modelo multimodal para analisar imagens no chat, por exemplo llama3.2-vision.
# Precisa estar disponível no serviço apontado por INFERENCE_BASE_URL.
VISION_MODEL=
# Execução Python opcional por broker privado. No Docker Compose local, habilite
# com `docker compose --profile python up -d` e configure URL/token/GID abaixo.
# No Coolify, configure a URL interna e o mesmo token nos recursos API e executor.
NODULO_PYTHON_SANDBOX_IMAGE=nodulo-python-sandbox:1.0
PYTHON_EXECUTOR_URL=
PYTHON_EXECUTOR_TOKEN=
PYTHON_EXECUTOR_CONCURRENCY=2
# GID do grupo dono de /var/run/docker.sock no servidor. Ex.: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# Pesquisa web: ativação, provedor e URL SearXNG são definidos na aba
# "Pesquisa web" do painel admin e persistidos no PostgreSQL da instalação.
# Use no painel a URL privada que a API consegue alcançar; não a URL do navegador.

# Portas publicadas no host local.
API_PORT=8081
WEB_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
# URL da API acessada pelo navegador. É incorporada ao bundle do Next.js durante o build.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/chat

# Backups automáticos opcionais no Compose local/standalone. Os arquivos ficam no volume
# postgresbackups, no mesmo host; copie-os para armazenamento externo e protegido.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Segredo JWT. Gere com `openssl rand -base64 48`. Obrigatório para iniciar o Compose.
JWT_SECRET=
# CIDRs dos proxies reversos confiáveis; vazio para desenvolvimento local sem proxy.
TRUSTED_PROXY_CIDRS=

# Diretório persistente dos arquivos-fonte da fila de ingestão.
# No Docker Compose, use o volume nomeado configurado automaticamente.
# Em execução local, pode ser um caminho absoluto com espaço suficiente para os arquivos enviados.
INGESTION_STORAGE_DIR=./data/ingestion

# Email inicial opcional, usado pelo serviço `seed-admin` após configurar uma senha.
ADMIN_EMAIL=admin@example.invalid
ADMIN_NAME=Administrador NÓDULO
ADMIN_PASSWORD=

# SMTP opcional para notificar decisões de cadastro.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=http://localhost:3000
